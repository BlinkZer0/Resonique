<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: back up the app's data (user presets and settings live in the WebView's
     local storage) to the user's cloud backup and transfer it to a new phone. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="root" path="app_webview/" />
    </cloud-backup>
    <device-transfer>
        <include domain="root" path="app_webview/" />
    </device-transfer>
</data-extraction-rules>
